# URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_RECIPIENT_EMAIL=x@sigitadi.id
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/meaqbvpa

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxx
CLERK_SECRET_KEY=sk_test_xxxx
# HALAMAN login (tujuan SEBELUM otentikasi). WAJIB /sign-in & /sign-up.
# Jangan isi /admin di sini — itu tujuan SETELAH login (lihat variabel
# CLERK_SIGN_IN_FORCE/FALLBACK_REDIRECT_URL di bawah). Mengisi /admin
# membuat auth.protect() mengalihkan user belum-login ke /admin, yang balik
# meminta login lagi → redirect loop tak terbatas (ERR_TOO_MANY_REDIRECTS).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Tujuan SETELAH login berhasil — /admin memang benar di sini.
CLERK_SIGN_IN_FORCE_REDIRECT_URL=/admin
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin

# ID Clerk User yang menjadi Admin / Pemilik website
ADMIN_CLERK_ID=user_xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADMIN_CLERK_ID=user_xxxxxxxxxxxxxxxxx

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Bunny CDN / Storage (opsional — upload masih lokal ke public/uploads jika kosong)
BUNNY_STORAGE_ZONE_NAME=nama-storage-zone
BUNNY_STORAGE_API_KEY=xxxx-xxxx-xxxx
BUNNY_CDN_HOSTNAME=namazone.b-cdn.net

# IndexNow (Bing & co) — GANTI default sebelum prod, jangan commit key asli
# Key BUKAN rahasia (harus bisa diambil crawler); rotasi key bisa dari /admin/seo.
INDEXNOW_KEY=e5b871c984924b179571fcfdca565780

# Verifikasi Search Engine (opsional — token BUKAN rahasia: sengaja dipublikasikan
# di <meta> & file statis agar crawler bisa mengambilnya. Kelola dari /admin/seo,
# simpan di tabel settings; env di bawah sebagai fallback pra-admin.)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Penerjemahan ID -> EN (Google Translate, fallback MyMemory)
# Opt-in per field via tombol di admin. Set "false" untuk mematikan egress sepenuhnya.
ENABLE_EXTERNAL_TRANSLATE=true

# Cloud AI Sigit_Bot (opt-in — default OFF = 100% lokal via TF-IDF, nol egress)
# Cara termudah: isi form Cloud AI di /admin/system (disimpan di tabel settings,
# menimpa env per-field — tidak perlu redeploy). Env di bawah sebagai alternatif.
#
# AI_PROVIDER=off (default) | gemini | openai | anthropic | deepseek | groq |
#            openrouter | together | mistral | xai
# Aktif hanya bila key provider terisi non-placeholder. KEY ADALAH SERVER-ONLY:
# jangan pernah pakai prefix NEXT_PUBLIC_ — apapun itu terkirim ke browser.
#
# Gemini (Google AI Studio):
# AI_PROVIDER=gemini
# GEMINI_API_KEY=ganti-dengan-key-asli-jangan-commit
# AI_MODEL=gemini-2.5-flash
#
# OpenAI-compatible — custom (OpenAI / Ollama / endpoint /v1/chat/completions lain):
# AI_PROVIDER=openai
# OPENAI_API_KEY=ganti-dengan-key-asli-jangan-commit
# OPENAI_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Anthropic Claude (messages API, berbeda dari OpenAI-compatible):
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=ganti-dengan-key-asli-jangan-commit
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
#
# Preset OpenAI-compatible lainnya (base URL otomatis sesuai registry, hanya
# perlu <PROVIDER>_API_KEY; daftar model bisa dilihat di form admin):
#   deepseek  → DEEPSEEK_API_KEY   (DEEPSEEK_MODEL=deepseek-chat)
#   groq      → GROQ_API_KEY       (GROQ_MODEL=llama-3.3-70b-versatile)
#   openrouter→ OPENROUTER_API_KEY (OPENROUTER_MODEL=google/gemini-2.5-flash)
#   together  → TOGETHER_API_KEY   (TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo)
#   mistral   → MISTRAL_API_KEY    (MISTRAL_MODEL=mistral-small-latest)
#   xai       → XAI_API_KEY        (XAI_MODEL=grok-2-latest)
AI_PROVIDER=off

# Dashboard visitor analytics eksternal (tombol di /admin) — opsional
# NEXT_PUBLIC_ANALYTICS_DASHBOARD_URL=https://portofolio-visitor-tracker.si-sigitadi.workers.dev/dashboard

# Catatan hardening:
# - Jangan commit .env.local / .env produksi
# - Jalankan `npm audit --audit-level=high` bulanan, lihat SECURITY.md §4-5
# - CSP & header ketat di next.config.ts; cek DevTools Console untuk violations
